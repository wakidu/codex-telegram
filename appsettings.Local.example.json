{
  "Codex": {
    "CodexPathOverride": ""
  },
  "TelegramBot": {
    "Enabled": true,
    "Token": "replace-with-your-telegram-bot-token",
    "AllowedUserIds": [
      123456789
    ],
    "AllowedChatIds": [],
    "DefaultWorkingDirectory": "C:\\src\\your-repo",
    "CodexExecutablePath": "",
    "MinAudioDurationSeconds": 1,
    "MaxAudioDurationSeconds": 600,
    "Outbound": {
      "DebugPreambleEnabled": false
    }
  },
  "OpenAI": {
    "ApiKey": "replace-with-your-openai-api-key",
    "Model": "whisper-1",
    "FfmpegPath": "ffmpeg"
  },
  "CodexTelegram": {
    "InitializeOnStart": true,
    "Context": {
      "WorkingDirectory": "C:\\src\\your-repo",
      "Sandbox": "workspace-write",
      "ApprovalMode": "on-request"
    },
    "Workspace": {
      "DataRoot": "",
      "WorkspaceRoots": [
        "C:\\src"
      ]
    },
    "Tailscale": {
      "ExecutablePath": "tailscale",
      "Ports": [3000, 3001, 3100, 3300, 3500, 4000],
      "Entries": [
        {
          "Name": "Default Next",
          "Port": 3000
        },
        {
          "Name": "Next 3001",
          "Port": 3001
        },
        {
          "Name": "SalonUp",
          "Port": 3100
        },
        {
          "Name": "Orcha",
          "Port": 3300
        },
        {
          "Name": "SalonUp Studio",
          "Port": 3500
        },
        {
          "Name": "SalonUp SuperAdmin",
          "Port": 4000
        }
      ]
    }
  }
}
